<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.member">
	<insert id="insertMember" parameterType="member">
		insert into member(id,name,password,email,address,detail_address,postcode,profile)
		values(#{id},#{name},#{password},#{email},#{address},#{detailAddress},#{postcode},#{profile})
	</insert>
	
	<select id="selectMember" resultType="member" parameterType="String">
		select * from member where id=#{id}
	</select>
</mapper>	